<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RadioPlayer.App"
             xmlns:local="using:RadioPlayer"
             xmlns:semi="https://irihi.tech/semi"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <FontFamily x:Key="EmojiFont">avares://RadioPlayer/Assets/Fonts/#Apple Color Emoji</FontFamily>
    </Application.Resources>
  
    <Application.Styles>
        <semi:SemiTheme/>
    </Application.Styles>

    <TrayIcon.Icons>
		<TrayIcons>
			<TrayIcon Icon="/Assets/logo.png"
                      ToolTipText="RadioPlayer">
				<TrayIcon.Menu>
                  <NativeMenu>
                    <NativeMenuItem Header="Favourites">
                      <NativeMenu>
                        <NativeMenuItem Header="Not" />
                        <NativeMenuItem Header="Yet" />
                        <NativeMenuItem Header="Implemented" />
                      </NativeMenu>
                    </NativeMenuItem>
                    <NativeMenuItem Header="Pause/Play" />
                    <NativeMenuItem Header="Random station" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="Quit application" />
                  </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>