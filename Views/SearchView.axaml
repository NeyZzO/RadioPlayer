<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RadioPlayer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="450"
             x:Class="RadioPlayer.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.search-box">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBox.search-box:focus">
            <Setter Property="BorderBrush" Value="#1DB954"/>
        </Style>
        <Style Selector="Button.search-btn">
            <Setter Property="Background" Value="#1DB954"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.search-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1ed760"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Padding="24,24,24,24" 
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <!-- En-tête -->
            <StackPanel Spacing="8">
                <TextBlock Text="Rechercher une station" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Trouvez des stations de radio par nom, genre ou pays." 
                           FontSize="14" Foreground="#888888" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Barre de recherche -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,8,0,0">
                <TextBox Grid.Column="0" 
                         Classes="search-box"
                         Watermark="Entrez le nom d'une station..."
                         Text="{Binding SearchQuery, Mode=TwoWay}"/>
                <Button Grid.Column="1" 
                        Classes="search-btn"
                        Margin="12,0,0,0"
                        Command="{Binding SearchCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🔎" FontSize="14" FontFamily="{StaticResource EmojiFont}"/>
                        <TextBlock Text="Rechercher"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Placeholder pour les résultats -->
            <Border Background="#252525" CornerRadius="12" Padding="32" Margin="0,16,0,0">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="🔎" FontSize="48" FontFamily="{StaticResource EmojiFont}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Lancez une recherche" 
                               FontSize="16" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                    <TextBlock Text="Les résultats de votre recherche apparaîtront ici" 
                               FontSize="13" Foreground="#666666" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
